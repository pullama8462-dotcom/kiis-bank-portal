POSTGRES_USER=kiis
POSTGRES_PASSWORD=kiis_pass
POSTGRES_DB=kiis_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
JWT_SECRET=replace-with-a-secure-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENV=production

